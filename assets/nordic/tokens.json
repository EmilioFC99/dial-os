{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "fjall": {
    "color": {
      "night": {
        "bg": {
          "$type": "color",
          "$value": "#121615",
          "$description": "Pine Night · screen background"
        },
        "s1": {
          "$type": "color",
          "$value": "#1A1F1D",
          "$description": "Surface 1 · rows, cards"
        },
        "s2": {
          "$type": "color",
          "$value": "#232927",
          "$description": "Surface 2 · focused row, icon wells"
        },
        "s3": {
          "$type": "color",
          "$value": "#2E3532",
          "$description": "Surface 3 · pressed, tracks, grips"
        },
        "line": {
          "$type": "color",
          "$value": "#2A312E",
          "$description": "Hairline · borders, dividers"
        },
        "t1": {
          "$type": "color",
          "$value": "#ECEEE8",
          "$description": "Snow · primary text"
        },
        "t2": {
          "$type": "color",
          "$value": "#A2ABA5",
          "$description": "Lichen · secondary text"
        },
        "t3": {
          "$type": "color",
          "$value": "#6F7974",
          "$description": "Granite · hints, disabled"
        },
        "moss": {
          "$type": "color",
          "$value": "#8DB596",
          "$description": "Mossa · primary accent"
        },
        "fjord": {
          "$type": "color",
          "$value": "#8FB3C9",
          "$description": "Fjord · connectivity, info"
        },
        "berry": {
          "$type": "color",
          "$value": "#E2A66A",
          "$description": "Hjortron (cloudberry) · warmth, warning, score"
        },
        "lingon": {
          "$type": "color",
          "$value": "#E07F76",
          "$description": "Lingon · destructive, error"
        },
        "birch": {
          "$type": "color",
          "$value": "#D8CFBD",
          "$description": "Björk sand · neutral highlight, brightness"
        },
        "heather": {
          "$type": "color",
          "$value": "#B7A0C6",
          "$description": "Ljung (heather) · modes app tint"
        },
        "onAccent": {
          "$type": "color",
          "$value": "#0F1D14",
          "$description": "Text/icon on a filled accent"
        }
      },
      "day": {
        "bg": {
          "$type": "color",
          "$value": "#F4F1EA",
          "$description": "Linen · screen background"
        },
        "s1": {
          "$type": "color",
          "$value": "#EAE6DD",
          "$description": "Oat · rows, cards"
        },
        "s2": {
          "$type": "color",
          "$value": "#DFDAD0",
          "$description": "Surface 2 · focused row, icon wells"
        },
        "s3": {
          "$type": "color",
          "$value": "#D0CABE",
          "$description": "Surface 3 · pressed, tracks, grips"
        },
        "line": {
          "$type": "color",
          "$value": "#D9D3C7",
          "$description": "Hairline · borders, dividers"
        },
        "t1": {
          "$type": "color",
          "$value": "#1C2220",
          "$description": "Pine ink · primary text"
        },
        "t2": {
          "$type": "color",
          "$value": "#545D58",
          "$description": "Slate moss · secondary text"
        },
        "t3": {
          "$type": "color",
          "$value": "#7E8681",
          "$description": "Pebble · hints, disabled"
        },
        "moss": {
          "$type": "color",
          "$value": "#47755A",
          "$description": "Mossa · primary accent"
        },
        "fjord": {
          "$type": "color",
          "$value": "#3B6A86",
          "$description": "Fjord · connectivity, info"
        },
        "berry": {
          "$type": "color",
          "$value": "#A9652B",
          "$description": "Hjortron · warmth, warning, score"
        },
        "lingon": {
          "$type": "color",
          "$value": "#AE463D",
          "$description": "Lingon · destructive, error"
        },
        "birch": {
          "$type": "color",
          "$value": "#857456",
          "$description": "Björk bark · neutral highlight"
        },
        "heather": {
          "$type": "color",
          "$value": "#76598A",
          "$description": "Ljung · modes app tint"
        },
        "onAccent": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "Text/icon on a filled accent"
        }
      }
    },
    "space": {
      "1": {
        "$type": "dimension",
        "$value": "4px"
      },
      "2": {
        "$type": "dimension",
        "$value": "8px"
      },
      "3": {
        "$type": "dimension",
        "$value": "12px"
      },
      "4": {
        "$type": "dimension",
        "$value": "16px"
      },
      "5": {
        "$type": "dimension",
        "$value": "20px"
      },
      "6": {
        "$type": "dimension",
        "$value": "24px"
      },
      "7": {
        "$type": "dimension",
        "$value": "32px"
      },
      "8": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "radius": {
      "xs": {
        "$type": "dimension",
        "$value": "8px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "md": {
        "$type": "dimension",
        "$value": "18px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "24px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "30px"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px"
      },
      "pebble": {
        "$type": "dimension",
        "$value": "50%"
      }
    },
    "motion": {
      "instant": {
        "$type": "transition",
        "$value": {
          "duration": "80ms",
          "timingFunction": "linear"
        }
      },
      "quick": {
        "$type": "transition",
        "$value": {
          "duration": "140ms",
          "timingFunction": "cubic-bezier(.2,.8,.2,1)"
        }
      },
      "settle": {
        "$type": "transition",
        "$value": {
          "duration": "200ms",
          "timingFunction": "cubic-bezier(.2,.8,.2,1)"
        }
      },
      "glide": {
        "$type": "transition",
        "$value": {
          "duration": "320ms",
          "timingFunction": "cubic-bezier(.4,0,.2,1)"
        }
      },
      "drift": {
        "$type": "transition",
        "$value": {
          "duration": "1200ms",
          "timingFunction": "linear"
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "64px",
          "fontWeight": 300,
          "letterSpacing": "-0.03em",
          "lineHeight": 1.25
        }
      },
      "hero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "40px",
          "fontWeight": 400,
          "letterSpacing": "-0.02em",
          "lineHeight": 1.25
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "22px",
          "fontWeight": 600,
          "letterSpacing": "-0.01em",
          "lineHeight": 1.25
        }
      },
      "headline": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "17px",
          "fontWeight": 600,
          "letterSpacing": "0",
          "lineHeight": 1.25
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "15px",
          "fontWeight": 500,
          "letterSpacing": "0",
          "lineHeight": 1.25
        }
      },
      "sub": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "13px",
          "fontWeight": 500,
          "letterSpacing": "0",
          "lineHeight": 1.25
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "11px",
          "fontWeight": 600,
          "letterSpacing": "0.14em",
          "lineHeight": 1.25
        }
      }
    }
  }
}